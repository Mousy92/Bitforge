{
  "name": "bitforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BitCraft build & crafting planner — compile everything a build needs, divided by profession, and share it with a link.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "build:local": "vite build --config vite.local.config.ts"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
